<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <!-- AOT 的 GC 配置在发布时固化：显式关闭 Server GC，避免多核 NAS 上按核建堆 -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <!-- 以少量 CPU 换取更小的代码段，减少常驻代码页 -->
        <OptimizationPreference>Size</OptimizationPreference>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0"/>
        <PackageReference Include="FreeSql" Version="3.5.311"/>
        <PackageReference Include="FreeSql.Provider.SqliteCore" Version="3.5.311"/>
        <!-- Microsoft.Data.Sqlite.Core 不自带原生 e_sqlite3，需显式引入 bundle 并在启动时初始化 -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13"/>
        <!-- OpenAPI 只用于开发期生成客户端类型，Release 发布不引用，避免编进 AOT 镜像 -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"
                          Condition="'$(Configuration)' == 'Debug'"/>
    </ItemGroup>

    <!-- AOT 下 GC 参数需在发布时固化，运行时改动无效 -->
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9"/>
    </ItemGroup>

    <!-- AOT 裁剪下保留 FreeSql 实体反射元数据，详见 TrimmerRoots.xml -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="TrimmerRoots.xml"/>
    </ItemGroup>

    <!-- 运行时上传目录（图片、Live2D 模型）属于用户数据，不参与编译与发布 -->
    <ItemGroup>
        <Content Remove="uploads\**"/>
        <None Remove="uploads\**"/>
    </ItemGroup>

</Project>
